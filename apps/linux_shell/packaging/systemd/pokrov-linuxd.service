[Unit]
Description=POKROV Linux privileged runtime service
Documentation=https://pokrov.space/help/
Requires=pokrov-linuxd.socket
After=NetworkManager.service systemd-resolved.service

[Service]
Type=simple
# linuxd restores DNS before stopping Core and releasing its firewall table.
KillMode=mixed
ExecStart=/usr/lib/pokrov/pokrov-linuxd
User=root
Group=root
StateDirectory=pokrov
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
ReadWritePaths=/var/lib/pokrov /run/pokrov
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=multi-user.target
